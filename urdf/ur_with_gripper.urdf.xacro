<?xml version="1.0"?>
<!--
  UR3/UR3e (ur_description) + tay gắp song song tự xây dựng (parallel_gripper.xacro).
  Nhận đúng các tham số của ur_description/urdf/ur.urdf.xacro (sim_ignition,
  simulation_controllers, ...) nên dùng được cho cả Gazebo Sim lẫn MoveIt 2.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="sim_ignition" default="false"/>
  <!-- Toàn bộ UR (tay máy + plugin ign_ros2_control nếu sim_ignition:=true) -->
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>
  <xacro:include filename="$(find ur3_llm_control)/urdf/parallel_gripper.xacro"/>

  <xacro:parallel_gripper parent="tool0" sim_ignition="$(arg sim_ignition)"/>
</robot>
